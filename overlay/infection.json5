{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["Kernel.php"]
    },
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection-summary.log"
    },
    "mutators": {
        "@default": true
    },
    "minCoveredMsi": 70
}
